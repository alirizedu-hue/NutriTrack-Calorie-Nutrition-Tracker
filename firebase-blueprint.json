{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information, preferences, and nutritional targets.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Authenticated Firebase User UID"
        },
        "name": {
          "type": "string",
          "description": "Display name of the user",
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "description": "Email address of the user",
          "maxLength": 150
        },
        "avatarUrl": {
          "type": "string",
          "description": "URL to the user avatar image",
          "maxLength": 500
        },
        "title": {
          "type": "string",
          "description": "User title or fitness goal tagline",
          "maxLength": 100
        },
        "dietaryPreference": {
          "type": "string",
          "description": "Dietary style (Balanced, High Protein, Mediterranean, etc.)",
          "enum": ["Balanced", "High Protein", "Mediterranean", "Vegetarian", "Plant-Based", "Low Carb", "Keto", "Vegan"]
        },
        "dietaryRestrictions": {
          "type": "array",
          "description": "List of allergies and dietary restrictions"
        },
        "preferredMeals": {
          "type": "array",
          "description": "List of active meal categories (breakfast, lunch, dinner, snacks)"
        },
        "dailyCalorieTarget": {
          "type": "number",
          "description": "Daily caloric target in kcal"
        },
        "dailyWaterTargetGlasses": {
          "type": "number",
          "description": "Daily water consumption target in standard glasses"
        },
        "dailyProteinTarget": {
          "type": "number",
          "description": "Daily protein target in grams"
        },
        "dailyCarbsTarget": {
          "type": "number",
          "description": "Daily carbohydrates target in grams"
        },
        "dailyFatTarget": {
          "type": "number",
          "description": "Daily dietary fat target in grams"
        },
        "dailyFiberTarget": {
          "type": "number",
          "description": "Daily fiber target in grams"
        },
        "measurementSystem": {
          "type": "string",
          "description": "Metric or Imperial unit system",
          "enum": ["metric", "imperial"]
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of account creation"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last profile update"
        }
      },
      "required": ["uid", "email", "name"]
    },
    "DailyLog": {
      "title": "DailyLog",
      "description": "Daily nutrition log containing logged food entries and water intake for a date.",
      "type": "object",
      "properties": {
        "date": {
          "type": "string",
          "description": "Date string in YYYY-MM-DD format",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "userId": {
          "type": "string",
          "description": "Authenticated Firebase User UID"
        },
        "waterGlasses": {
          "type": "number",
          "description": "Number of glasses of water logged for this date"
        },
        "entries": {
          "type": "array",
          "description": "List of meal food entries logged for this date"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update"
        }
      },
      "required": ["date", "userId", "waterGlasses", "entries"]
    },
    "ScannedMeal": {
      "title": "ScannedMeal",
      "description": "AI food vision scan record with detected items and macro breakdown.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique scan ID"
        },
        "userId": {
          "type": "string",
          "description": "Authenticated Firebase User UID"
        },
        "timestamp": {
          "type": "string",
          "description": "ISO timestamp of the scan"
        },
        "title": {
          "type": "string",
          "description": "Detected meal title",
          "maxLength": 200
        },
        "mealType": {
          "type": "string",
          "description": "Meal category (breakfast, lunch, dinner, snacks)",
          "enum": ["breakfast", "lunch", "dinner", "snacks"]
        },
        "totalCalories": {
          "type": "number",
          "description": "Total estimated meal calories"
        },
        "totalProtein": {
          "type": "number",
          "description": "Total estimated meal protein in grams"
        },
        "totalCarbs": {
          "type": "number",
          "description": "Total estimated meal carbohydrates in grams"
        },
        "totalFat": {
          "type": "number",
          "description": "Total estimated meal fat in grams"
        },
        "totalFiber": {
          "type": "number",
          "description": "Total estimated meal fiber in grams"
        },
        "confidenceLevel": {
          "type": "string",
          "description": "Vision analysis confidence score (high, medium, low)"
        },
        "nutritionalNotes": {
          "type": "string",
          "description": "Dietary observations and guidance"
        },
        "foods": {
          "type": "array",
          "description": "Array of individual detected food components"
        },
        "imageUrl": {
          "type": "string",
          "description": "Optional meal photo thumbnail or data URL"
        }
      },
      "required": ["id", "userId", "timestamp", "title", "mealType", "totalCalories"]
    },
    "CustomFood": {
      "title": "CustomFood",
      "description": "User-created custom food item added to their personal library.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique food item ID"
        },
        "userId": {
          "type": "string",
          "description": "Authenticated Firebase User UID"
        },
        "name": {
          "type": "string",
          "description": "Food item name",
          "maxLength": 150
        },
        "category": {
          "type": "string",
          "description": "Food category classification"
        },
        "servingSize": {
          "type": "number",
          "description": "Standard serving size number"
        },
        "servingUnit": {
          "type": "string",
          "description": "Serving unit (g, ml, cup, oz, etc.)"
        },
        "calories": {
          "type": "number",
          "description": "Calories per serving"
        },
        "protein": {
          "type": "number",
          "description": "Protein per serving in grams"
        },
        "carbs": {
          "type": "number",
          "description": "Carbohydrates per serving in grams"
        },
        "fat": {
          "type": "number",
          "description": "Fat per serving in grams"
        },
        "fiber": {
          "type": "number",
          "description": "Fiber per serving in grams"
        },
        "isCustom": {
          "type": "boolean",
          "description": "Always true for custom items"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of creation"
        }
      },
      "required": ["id", "userId", "name", "servingSize", "servingUnit", "calories"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Stores personal user profile, nutritional targets, and dietary preferences for the authenticated user."
    },
    "/users/{userId}/dailyLogs/{date}": {
      "schema": "DailyLog",
      "description": "Stores daily food log entries, meal allocations, and water intake records for a specific date."
    },
    "/users/{userId}/scannedMeals/{mealId}": {
      "schema": "ScannedMeal",
      "description": "Stores AI meal scan records and photo nutrition breakdowns for the authenticated user."
    },
    "/users/{userId}/customFoods/{foodId}": {
      "schema": "CustomFood",
      "description": "Stores private custom food items created by the user."
    }
  }
}
