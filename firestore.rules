rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Security Primitives & Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Authenticated user private documents and subcollections
    // Covers /users/{userId}, /users/{userId}/dailyLogs/{date},
    // /users/{userId}/scannedMeals/{mealId}, /users/{userId}/customFoods/{foodId}, etc.
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /{subcollection=**} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
